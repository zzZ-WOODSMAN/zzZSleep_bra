      "bodyHtml": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Splash Screen</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Manrope:wght@400;600&display=swap\" rel=\"stylesheet\">\n<script>\n(function(){\n  var themes = {\n    purple: {p:'#800ffc', p2:'#a855f7', pdark:'#0d0518', glow:'rgba(128,15,252,0.55)', bg1:'#1a0a2e', bg2:'#0d0518', bg3:'#060210', orb3:'#c084fc', particle:'#d8b4fe', core2:'#5b0fc7', text2:'#e9d5ff', text3:'#c9b8e8', cardBorder:'rgba(168,85,247,0.35)', cardShadow:'rgba(128,15,252,0.25)', grid:'rgba(128,15,252,0.12)'},\n    yellow: {p:'#e0a415', p2:'#f2c14e', pdark:'#1a1206', glow:'rgba(224,164,21,0.55)', bg1:'#2e2308', bg2:'#1a1206', bg3:'#0a0705', orb3:'#f4d06f', particle:'#f7dfa5', core2:'#b8790a', text2:'#fdf1d3', text3:'#e8dcc0', cardBorder:'rgba(242,193,78,0.35)', cardShadow:'rgba(224,164,21,0.25)', grid:'rgba(224,164,21,0.12)'},\n    green: {p:'#16a34a', p2:'#4ade80', pdark:'#052e13', glow:'rgba(22,163,74,0.55)', bg1:'#0b3320', bg2:'#052e13', bg3:'#031a0b', orb3:'#86efac', particle:'#bbf7d0', core2:'#0d6b34', text2:'#dcfce7', text3:'#bbe8cc', cardBorder:'rgba(74,222,128,0.35)', cardShadow:'rgba(22,163,74,0.25)', grid:'rgba(22,163,74,0.12)'},\n    navy: {p:'#1d4ed8', p2:'#3b82f6', pdark:'#05102b', glow:'rgba(29,78,216,0.55)', bg1:'#0b1f4d', bg2:'#05102b', bg3:'#020a1a', orb3:'#60a5fa', particle:'#bfdbfe', core2:'#173f9e', text2:'#dbeafe', text3:'#c3d4f0', cardBorder:'rgba(59,130,246,0.35)', cardShadow:'rgba(29,78,216,0.25)', grid:'rgba(29,78,216,0.12)'},\n    sky: {p:'#0ea5e9', p2:'#38bdf8', pdark:'#04283a', glow:'rgba(14,165,233,0.55)', bg1:'#083754', bg2:'#04283a', bg3:'#021621', orb3:'#7dd3fc', particle:'#bae6fd', core2:'#0b6ea8', text2:'#e0f2fe', text3:'#c3e6f7', cardBorder:'rgba(56,189,248,0.35)', cardShadow:'rgba(14,165,233,0.25)', grid:'rgba(14,165,233,0.12)'},\n    silver: {p:'#9ca3af', p2:'#e5e7eb', pdark:'#111214', glow:'rgba(156,163,175,0.45)', bg1:'#26282b', bg2:'#111214', bg3:'#08090a', orb3:'#d1d5db', particle:'#f3f4f6', core2:'#6b7280', text2:'#f9fafb', text3:'#d1d5db', cardBorder:'rgba(229,231,235,0.3)', cardShadow:'rgba(156,163,175,0.2)', grid:'rgba(156,163,175,0.12)'},\n    teal: {p:'#0d9488', p2:'#2dd4bf', pdark:'#042925', glow:'rgba(13,148,136,0.55)', bg1:'#0a3d36', bg2:'#042925', bg3:'#021613', orb3:'#5eead4', particle:'#99f6e4', core2:'#0a6359', text2:'#ccfbf1', text3:'#a9e2da', cardBorder:'rgba(45,212,191,0.35)', cardShadow:'rgba(13,148,136,0.25)', grid:'rgba(13,148,136,0.12)'},\n    gold: {p:'#d4af37', p2:'#f5d576', pdark:'#241c05', glow:'rgba(212,175,55,0.55)', bg1:'#3a2e0a', bg2:'#241c05', bg3:'#120e02', orb3:'#f0dc93', particle:'#f9ecc2', core2:'#a1791f', text2:'#fdf6df', text3:'#ecd9a3', cardBorder:'rgba(245,213,118,0.35)', cardShadow:'rgba(212,175,55,0.25)', grid:'rgba(212,175,55,0.12)'},\n    monochrome: {p:'#ffffff', p2:'#cccccc', pdark:'#000000', glow:'rgba(255,255,255,0.35)', bg1:'#1a1a1a', bg2:'#000000', bg3:'#000000', orb3:'#999999', particle:'#e5e5e5', core2:'#4d4d4d', text2:'#f2f2f2', text3:'#cccccc', cardBorder:'rgba(255,255,255,0.25)', cardShadow:'rgba(255,255,255,0.15)', grid:'rgba(255,255,255,0.08)'}\n  };\n  var keys = Object.keys(themes);\n  var chosen = themes[keys[Math.floor(Math.random()*keys.length)]];\n  var root = document.documentElement.style;\n  root.setProperty('--p', chosen.p);\n  root.setProperty('--p2', chosen.p2);\n  root.setProperty('--p-dark', chosen.pdark);\n  root.setProperty('--glow', chosen.glow);\n  root.setProperty('--bg1', chosen.bg1);\n  root.setProperty('--bg2', chosen.bg2);\n  root.setProperty('--bg3', chosen.bg3);\n  root.setProperty('--orb3', chosen.orb3);\n  root.setProperty('--particle', chosen.particle);\n  root.setProperty('--core2', chosen.core2);\n  root.setProperty('--text2', chosen.text2);\n  root.setProperty('--text3', chosen.text3);\n  root.setProperty('--card-border', chosen.cardBorder);\n  root.setProperty('--card-shadow', chosen.cardShadow);\n  root.setProperty('--grid-line', chosen.grid);\n})();\n</script>\n<style>\n  :root{\n    --p:#e0a415;\n    --p2:#f2c14e;\n    --p-dark:#1a1206;\n    --glow: rgba(224,164,21,0.55);\n    --bg1:#2e2308;\n    --bg2:#1a1206;\n    --bg3:#0a0705;\n    --orb3:#f4d06f;\n    --particle:#f7dfa5;\n    --core2:#b8790a;\n    --text2:#fdf1d3;\n    --text3:#e8dcc0;\n    --card-border: rgba(242,193,78,0.35);\n    --card-shadow: rgba(224,164,21,0.25);\n    --grid-line: rgba(224,164,21,0.12);\n  }\n  *{margin:0;padding:0;box-sizing:border-box;font-family:'Cairo','Manrope',sans-serif;}\n  html,body{\n    height:100%;\n    background:radial-gradient(circle at 50% 30%, var(--bg1) 0%, var(--bg2) 55%, var(--bg3) 100%);\n    overflow:hidden;\n  }\n  .screen{\n    position:relative;\n    width:100%;\n    height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    color:#fff;\n    text-align:center;\n  }\n  .fade-black{\n    position:absolute;\n    inset:0;\n    background:#000;\n    opacity:0;\n    pointer-events:none;\n    z-index:50;\n    animation: toBlack 2.2s ease forwards 2900ms;\n  }\n  @keyframes toBlack{\n    from{opacity:0;}\n    to{opacity:1;}\n  }\n\n  /* animated grid backdrop like a builder canvas */\n  .grid{\n    position:absolute;inset:0;\n    background-image:\n      linear-gradient(var(--grid-line) 1px, transparent 1px),\n      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);\n    background-size:48px 48px;\n    mask-image: radial-gradient(circle at 50% 40%, black 10%, transparent 75%);\n    animation: gridMove 12s linear infinite;\n  }\n  @keyframes gridMove{\n    0%{background-position:0 0,0 0;}\n    100%{background-position:48px 48px,48px 48px;}\n  }\n\n  /* glowing orbs */\n  .orb{\n    position:absolute;\n    border-radius:50%;\n    filter:blur(60px);\n    opacity:0.55;\n    animation: float 8s ease-in-out infinite;\n  }\n  .orb1{width:340px;height:340px;background:var(--p);top:-100px;left:-80px;animation-delay:0s;}\n  .orb2{width:280px;height:280px;background:var(--p2);bottom:-100px;right:-60px;animation-delay:2s;}\n  .orb3{width:200px;height:200px;background:var(--orb3);top:60%;left:70%;animation-delay:4s;}\n  @keyframes float{\n    0%,100%{transform:translateY(0) scale(1);}\n    50%{transform:translateY(-30px) scale(1.08);}\n  }\n\n  /* particles */\n  .particle{\n    position:absolute;\n    width:4px;height:4px;\n    background:var(--particle);\n    border-radius:50%;\n    box-shadow:0 0 8px 2px var(--glow);\n    animation: rise linear infinite;\n  }\n  @keyframes rise{\n    0%{transform:translateY(0);opacity:0;}\n    10%{opacity:1;}\n    90%{opacity:1;}\n    100%{transform:translateY(-100vh);opacity:0;}\n  }\n\n  /* logo */\n  .logo-wrap{\n    position:relative;\n    width:130px;height:130px;\n    margin-bottom:36px;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .logo-ring{\n    position:absolute;inset:0;\n    border-radius:32px;\n    border:2px solid transparent;\n    background:linear-gradient(135deg,var(--p),var(--p2)) border-box;\n    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);\n    -webkit-mask-composite: xor;\n    mask-composite: exclude;\n    animation: spin 6s linear infinite;\n    box-shadow:0 0 40px var(--glow);\n  }\n  @keyframes spin{\n    0%{transform:rotate(0deg);}\n    100%{transform:rotate(360deg);}\n  }\n  .logo-core{\n    width:88px;height:88px;\n    border-radius:24px;\n    background:linear-gradient(145deg,var(--p),var(--core2));\n    display:flex;align-items:center;justify-content:center;\n    box-shadow:\n      0 0 25px var(--glow),\n      inset 0 0 20px rgba(255,255,255,0.25);\n    animation: pulse 2.4s ease-in-out infinite;\n  }\n  @keyframes pulse{\n    0%,100%{transform:scale(1);box-shadow:0 0 25px var(--glow), inset 0 0 20px rgba(255,255,255,0.25);}\n    50%{transform:scale(1.06);box-shadow:0 0 45px var(--glow), inset 0 0 25px rgba(255,255,255,0.35);}\n  }\n  .logo-core svg{width:44px;height:44px;fill:#fff;}\n\n  /* text */\n  .brand{\n    direction:ltr;\n    unicode-bidi:isolate;\n    font-size:36px;\n    font-weight:800;\n    letter-spacing:0;\n    line-height:1.3;\n    background:linear-gradient(90deg,#fff,var(--text2),var(--p2));\n    background-size:200% auto;\n    -webkit-background-clip:text;\n    background-clip:text;\n    color:transparent;\n    animation: shine 3s linear infinite;\n    margin-bottom:12px;\n  }\n  @keyframes shine{\n    0%{background-position:200% center;}\n    100%{background-position:0% center;}\n  }\n  .tagline{\n    font-size:16px;\n    font-weight:400;\n    color:var(--text3);\n    opacity:0;\n    animation: fadeUp 1s ease forwards 0.5s;\n    letter-spacing:0;\n  }\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(12px);}\n    to{opacity:1;transform:translateY(0);}\n  }\n\n  /* dashboard preview cards floating below */\n  .cards{\n    display:flex;\n    gap:14px;\n    margin-top:46px;\n    opacity:0;\n    animation: fadeUp 1s ease forwards 0.9s;\n  }\n  .card{\n    width:64px;height:64px;\n    border-radius:16px;\n    background:rgba(255,255,255,0.05);\n    border:1px solid var(--card-border);\n    backdrop-filter: blur(6px);\n    display:flex;align-items:center;justify-content:center;\n    box-shadow:0 0 18px var(--card-shadow);\n    animation: bob 3s ease-in-out infinite;\n  }\n  .card:nth-child(2){animation-delay:0.3s;}\n  .card:nth-child(3){animation-delay:0.6s;}\n  .card:nth-child(4){animation-delay:0.9s;}\n  @keyframes bob{\n    0%,100%{transform:translateY(0);}\n    50%{transform:translateY(-8px);}\n  }\n  .card svg{width:26px;height:26px;stroke:var(--particle);fill:none;stroke-width:1.6;}\n\n  /* loader bar */\n  .loader{\n    width:180px;\n    height:4px;\n    border-radius:4px;\n    background:rgba(255,255,255,0.08);\n    margin-top:52px;\n    overflow:hidden;\n    opacity:0;\n    animation:\n      fadeUp 1s ease forwards 1.2s,\n      loaderHide 0.3s ease forwards 2600ms;\n  }\n  .loader-fill{\n    height:100%;\n    width:0%;\n    border-radius:4px;\n    background:linear-gradient(90deg,var(--p),var(--text2));\n    box-shadow:0 0 10px var(--glow);\n    animation: loadOnce 1.4s ease-out forwards 1.2s;\n  }\n  @keyframes loadOnce{\n    0%{width:0%;}\n    100%{width:100%;}\n  }\n  @keyframes loaderHide{\n    from{opacity:1;}\n    to{opacity:0;}\n  }\n</style>\n</head>\n<body>\n<div class=\"screen\">\n  <div class=\"grid\"></div>\n  <div class=\"orb orb1\"></div>\n  <div class=\"orb orb2\"></div>\n  <div class=\"orb orb3\"></div>\n  <div id=\"particles\"></div>\n\n  <div class=\"logo-wrap\">\n    <div class=\"logo-ring\"></div>\n    <div class=\"logo-core\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M12 4v16M4 12h16\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></svg>\n    </div>\n  </div>\n\n<div class=\"brand\" dir=\"ltr\">{{APP_NAME}}</div>\n  <div class=\"tagline\">الطريق الأمتع لبناء تطبيقك</div>\n\n\n  <div class=\"cards\">\n    <div class=\"card\" title=\"GitHub\"><svg viewBox=\"0 0 24 24\" stroke-width=\"1.4\"><path d=\"M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.31 6.84 9.66.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.88-2.78.62-3.37-1.21-3.37-1.21-.46-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05a9.28 9.28 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.2C22 6.58 17.52 2 12 2z\"/></svg></div>\n    <div class=\"card\" title=\"Cloudflare\"><svg viewBox=\"0 0 24 24\" stroke-width=\"1.4\"><path d=\"M3 16.5c-1-2.4.4-5 3-5.3.6-3 3.2-5.2 6.3-5.2 2.6 0 4.9 1.5 6 3.8 2.4-.1 4.3 1.7 4.4 4 .1 1.4-.5 2.7-1.6 3.5\"/><path d=\"M6 17h13\"/></svg></div>\n    <div class=\"card\" title=\"نشر\"><svg viewBox=\"0 0 24 24\" stroke-width=\"1.4\"><path d=\"M12 3v12\"/><path d=\"M7 8l5-5 5 5\"/><path d=\"M5 21h14\"/></svg></div>\n    <div class=\"card\" title=\"كود\"><svg viewBox=\"0 0 24 24\" stroke-width=\"1.4\"><path d=\"M8 6l-6 6 6 6M16 6l6 6-6 6\"/></svg></div>\n  </div>\n\n  <div class=\"loader\"><div class=\"loader-fill\"></div></div>\n  <div class=\"fade-black\"></div>\n</div>\n\n<script>\n  const container = document.getElementById('particles');\n  const count = 28;\n  for(let i=0;i<count;i++){\n    const p = document.createElement('div');\n    p.className='particle';\n    const left = Math.random()*100;\n    const delay = Math.random()*8;\n    const duration = 6+Math.random()*6;\n    p.style.left = left+'vw';\n    p.style.bottom = '-10px';\n    p.style.animationDuration = duration+'s';\n    p.style.animationDelay = delay+'s';\n    container.appendChild(p);\n  }\n</script>\n</body>\n</html>\n"
    }
