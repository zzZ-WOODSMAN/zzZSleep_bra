      "bodyHtml": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Splash Screen</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Manrope:wght@400;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --p:#800ffc;\n    --p2:#a855f7;\n    --p-dark:#0d0518;\n    --glow: rgba(128,15,252,0.55);\n  }\n  *{margin:0;padding:0;box-sizing:border-box;font-family:'Cairo','Manrope',sans-serif;}\n  html,body{\n    height:100%;\n    background:radial-gradient(circle at 50% 30%, #1a0a2e 0%, #0d0518 55%, #060210 100%);\n    overflow:hidden;\n  }\n  .screen{\n    position:relative;\n    width:100%;\n    height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    color:#fff;\n    text-align:center;\n  }\n  .fade-black{\n    position:absolute;\n    inset:0;\n    background:#000;\n    opacity:0;\n    pointer-events:none;\n    z-index:50;\n    animation: toBlack 2.2s ease forwards 2900ms;\n  }\n  @keyframes toBlack{\n    from{opacity:0;}\n    to{opacity:1;}\n  }\n\n  /* animated grid backdrop like a builder canvas */\n  .grid{\n    position:absolute;inset:0;\n    background-image:\n      linear-gradient(rgba(128,15,252,0.12) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(128,15,252,0.12) 1px, transparent 1px);\n    background-size:48px 48px;\n    mask-image: radial-gradient(circle at 50% 40%, black 10%, transparent 75%);\n    animation: gridMove 12s linear infinite;\n  }\n  @keyframes gridMove{\n    0%{background-position:0 0,0 0;}\n    100%{background-position:48px 48px,48px 48px;}\n  }\n\n  /* glowing orbs */\n  .orb{\n    position:absolute;\n    border-radius:50%;\n    filter:blur(60px);\n    opacity:0.55;\n    animation: float 8s ease-in-out infinite;\n  }\n  .orb1{width:340px;height:340px;background:var(--p);top:-100px;left:-80px;animation-delay:0s;}\n  .orb2{width:280px;height:280px;background:var(--p2);bottom:-100px;right:-60px;animation-delay:2s;}\n  .orb3{width:200px;height:200px;background:#c084fc;top:60%;left:70%;animation-delay:4s;}\n  @keyframes float{\n    0%,100%{transform:translateY(0) scale(1);}\n    50%{transform:translateY(-30px) scale(1.08);}\n  }\n\n  /* particles */\n  .particle{\n    position:absolute;\n    width:4px;height:4px;\n    background:#d8b4fe;\n    border-radius:50%;\n    box-shadow:0 0 8px 2px var(--glow);\n    animation: rise linear infinite;\n  }\n  @keyframes rise{\n    0%{transform:translateY(0);opacity:0;}\n    10%{opacity:1;}\n    90%{opacity:1;}\n    100%{transform:translateY(-100vh);opacity:0;}\n  }\n\n  /* logo */\n  .logo-wrap{\n    position:relative;\n    width:130px;height:130px;\n    margin-bottom:36px;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .logo-ring{\n    position:absolute;inset:0;\n    border-radius:32px;\n    border:2px solid transparent;\n    background:linear-gradient(135deg,var(--p),var(--p2)) border-box;\n    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);\n    -webkit-mask-composite: xor;\n    mask-composite: exclude;\n    animation: spin 6s linear infinite;\n    box-shadow:0 0 40px var(--glow);\n  }\n  @keyframes spin{\n    0%{transform:rotate(0deg);}\n    100%{transform:rotate(360deg);}\n  }\n  .logo-core{\n    width:88px;height:88px;\n    border-radius:24px;\n    background:linear-gradient(145deg,var(--p),#5b0fc7);\n    display:flex;align-items:center;justify-content:center;\n    box-shadow:\n      0 0 25px var(--glow),\n      inset 0 0 20px rgba(255,255,255,0.25);\n    animation: pulse 2.4s ease-in-out infinite;\n  }\n  @keyframes pulse{\n    0%,100%{transform:scale(1);box-shadow:0 0 25px var(--glow), inset 0 0 20px rgba(255,255,255,0.25);}\n    50%{transform:scale(1.06);box-shadow:0 0 45px var(--glow), inset 0 0 25px rgba(255,255,255,0.35);}\n  }\n  .logo-core svg{width:44px;height:44px;fill:#fff;}\n\n  /* text */\n  .brand{\n    font-size:36px;\n    font-weight:800;\n    letter-spacing:0;\n    line-height:1.3;\n    background:linear-gradient(90deg,#fff,#e9d5ff,var(--p2));\n    background-size:200% auto;\n    -webkit-background-clip:text;\n    background-clip:text;\n    color:transparent;\n    animation: shine 3s linear infinite;\n    margin-bottom:12px;\n  }\n  @keyframes shine{\n    0%{background-position:0% center;}\n    100%{background-position:200% center;}\n  }\n  .tagline{\n    font-size:16px;\n    font-weight:400;\n    color:#c9b8e8;\n    opacity:0;\n    animation: fadeUp 1s ease forwards 0.5s;\n    letter-spacing:0;\n  }\n  @keyframes fadeUp{\n    from{opacity:0;transform:translateY(12px);}\n    to{opacity:1;transform:translateY(0);}\n  }\n\n  /* dashboard preview cards floating below */\n  .cards{\n    display:flex;\n    gap:14px;\n    margin-top:46px;\n    opacity:0;\n    animation: fadeUp 1s ease forwards 0.9s;\n  }\n  .card{\n    width:64px;height:64px;\n    border-radius:16px;\n    background:rgba(255,255,255,0.05);\n    border:1px solid rgba(168,85,247,0.35);\n    backdrop-filter: blur(6px);\n    display:flex;align-items:center;justify-content:center;\n    box-shadow:0 0 18px rgba(128,15,252,0.25);\n    animation: bob 3s ease-in-out infinite;\n  }\n  .card:nth-child(2){animation-delay:0.3s;}\n  .card:nth-child(3){animation-delay:0.6s;}\n  .card:nth-child(4){animation-delay:0.9s;}\n  @keyframes bob{\n    0%,100%{transform:translateY(0);}\n    50%{transform:translateY(-8px);}\n  }\n  .card svg{width:26px;height:26px;stroke:#d8b4fe;fill:none;stroke-width:1.6;}\n\n  /* loader bar */\n  .loader{\n    width:180px;\n    height:4px;\n    border-radius:4px;\n    background:rgba(255,255,255,0.08);\n    margin-top:52px;\n    overflow:hidden;\n    opacity:0;\n    animation:\n      fadeUp 1s ease forwards 1.2s,\n      loaderHide 0.3s ease forwards 2600ms;\n  }\n  .loader-fill{\n    height:100%;\n    width:0%;\n    border-radius:4px;\n    background:linear-gradient(90deg,var(--p),#e9d5ff);\n    box-shadow:0 0 10px var(--glow);\n    animation: loadOnce 1.4s ease-out forwards 1.2s;\n  }\n  @keyframes loadOnce{\n    0%{width:0%;}\n    100%{width:100%;}\n  }\n  @keyframes loaderHide{\n    from{opacity:1;}\n    to{opacity:0;}\n  }\n</style>\n</head>\n<body>\n<div class=\"screen\">\n  <div class=\"grid\"></div>\n  <div class=\"orb orb1\"></div>\n  <div class=\"orb orb2\"></div>\n  <div class=\"orb orb3\"></div>\n  <div id=\"particles\"></div>\n\n  <div class=\"logo-wrap\">\n    <div class=\"logo-ring\"></div>\n    <div class=\"logo-core\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M4 13h5v7H4zM10 4h5v16h-5zM16 9h5v11h-5z\"/></svg>\n    </div>\n  </div>\n\n<div class=\"brand\">{{APP_NAME}}</div>\n  <div class=\"tagline\">الطريق الأمتع لبناء تطبيقك</div>\n\n\n  <div class=\"cards\">\n    <div class=\"card\" title=\"GitHub\"><svg viewBox=\"0 0 24 24\" stroke-width=\"1.4\"><path d=\"M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.31 6.84 9.66.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.88-2.78.62-3.37-1.21-3.37-1.21-.46-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05a9.28 9.28 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.2C22 6.58 17.52 2 12 2z\"/></svg></div>\n    <div class=\"card\" title=\"Cloudflare\"><svg viewBox=\"0 0 24 24\" stroke-width=\"1.4\"><path d=\"M3 16.5c-1-2.4.4-5 3-5.3.6-3 3.2-5.2 6.3-5.2 2.6 0 4.9 1.5 6 3.8 2.4-.1 4.3 1.7 4.4 4 .1 1.4-.5 2.7-1.6 3.5\"/><path d=\"M6 17h13\"/></svg></div>\n    <div class=\"card\" title=\"نشر\"><svg viewBox=\"0 0 24 24\" stroke-width=\"1.4\"><path d=\"M12 3v12\"/><path d=\"M7 8l5-5 5 5\"/><path d=\"M5 21h14\"/></svg></div>\n    <div class=\"card\" title=\"كود\"><svg viewBox=\"0 0 24 24\" stroke-width=\"1.4\"><path d=\"M8 6l-6 6 6 6M16 6l6 6-6 6\"/></svg></div>\n  </div>\n\n  <div class=\"loader\"><div class=\"loader-fill\"></div></div>\n  <div class=\"fade-black\"></div>\n</div>\n\n<script>\n  const container = document.getElementById('particles');\n  const count = 28;\n  for(let i=0;i<count;i++){\n    const p = document.createElement('div');\n    p.className='particle';\n    const left = Math.random()*100;\n    const delay = Math.random()*8;\n    const duration = 6+Math.random()*6;\n    p.style.left = left+'vw';\n    p.style.bottom = '-10px';\n    p.style.animationDuration = duration+'s';\n    p.style.animationDelay = delay+'s';\n    container.appendChild(p);\n  }\n</script>\n</body>\n</html>"
    }
  ],
  "gitixColors": []
}