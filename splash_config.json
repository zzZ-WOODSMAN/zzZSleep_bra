      "borderChange": false,
      "bodyHtml": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>رياضيات</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@700&family=IBM+Plex+Sans+Arabic:wght@300;400&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --board-900:#0F241C;\n    --board-700:#1C3A2C;\n    --chalk-100:#EAF3EA;\n    --mint-400:#8FCBA0;\n    --mint-300:#B9E3C4;\n    --mint-glow:rgba(143,203,160,.55);\n    --line-soft:rgba(234,243,234,.14);\n  }\n\n  *{ box-sizing:border-box; margin:0; padding:0; }\n\n  html,body{\n    height:100%;\n    background: radial-gradient(ellipse 110% 85% at 50% 35%, var(--board-700) 0%, var(--board-900) 68%);\n    overflow:hidden;\n  }\n\n  body{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-family:'IBM Plex Sans Arabic', sans-serif;\n    color:var(--chalk-100);\n    position:relative;\n    min-height:100vh;\n  }\n\n  /* drifting chalk dust */\n  .dust{\n    position:absolute;\n    inset:0;\n    overflow:hidden;\n    pointer-events:none;\n    z-index:1;\n  }\n  .mote{\n    position:absolute;\n    border-radius:50%;\n    background:var(--chalk-100);\n    opacity:0;\n    animation: rise linear infinite, fadeMote ease-in-out infinite;\n  }\n  @keyframes rise{\n    0%{ transform:translateY(0); }\n    100%{ transform:translateY(-120vh); }\n  }\n  @keyframes fadeMote{\n    0%,100%{ opacity:0; }\n    15%,85%{ opacity:.3; }\n  }\n\n  .stage{\n    position:relative;\n    z-index:2;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    text-align:center;\n    padding: 6vh 8vw;\n    max-width:520px;\n  }\n\n  .plot-wrap{\n    width:min(58vw, 320px);\n    height:min(58vw, 320px);\n    margin-bottom:1.6rem;\n    position:relative;\n  }\n\n  .axis{\n    stroke:var(--line-soft);\n    stroke-width:1.2;\n    stroke-dasharray:260;\n    stroke-dashoffset:260;\n    animation: drawLine .7s ease-out forwards;\n  }\n  .axis.y{ animation-delay:.1s; }\n  .axis.x{ animation-delay:.35s; }\n\n  @keyframes drawLine{\n    to{ stroke-dashoffset:0; }\n  }\n\n  .tick{\n    stroke:var(--line-soft);\n    stroke-width:1.2;\n    opacity:0;\n    animation: tickIn .3s ease-out forwards;\n  }\n\n  @keyframes tickIn{\n    to{ opacity:1; }\n  }\n\n  .curve{\n    fill:none;\n    stroke:var(--mint-400);\n    stroke-width:2.4;\n    stroke-linecap:round;\n    stroke-dasharray:340;\n    stroke-dashoffset:340;\n    filter: drop-shadow(0 0 6px var(--mint-glow));\n    animation: drawCurve 1.7s cubic-bezier(.3,.05,.15,1) forwards;\n    animation-delay:1.05s;\n  }\n  @keyframes drawCurve{\n    to{ stroke-dashoffset:0; }\n  }\n\n  .tracer{\n    fill:var(--mint-300);\n    opacity:0;\n    filter: drop-shadow(0 0 9px var(--mint-glow));\n    offset-path: path(\"M42,214 C 76,214 92,90 160,90 C 228,90 244,214 278,214\");\n    offset-rotate:0deg;\n    animation: trace 1.7s cubic-bezier(.3,.05,.15,1) forwards;\n    animation-delay:1.05s;\n  }\n  @keyframes trace{\n    0%{ opacity:1; offset-distance:0%; }\n    98%{ opacity:1; }\n    100%{ offset-distance:100%; opacity:0; }\n  }\n\n  .peak{\n    fill:var(--mint-300);\n    opacity:0;\n    filter: drop-shadow(0 0 10px var(--mint-glow));\n    animation: peakPop .8s ease-out forwards, pulse 2.4s ease-in-out infinite;\n    animation-delay:2.55s, 3.35s;\n  }\n  @keyframes peakPop{\n    0%{ opacity:0; r:0; }\n    100%{ opacity:1; r:3.4; }\n  }\n  @keyframes pulse{\n    0%,100%{ opacity:.85; }\n    50%{ opacity:1; }\n  }\n\n  .wordmark{\n    font-family:'Aref Ruqaa', serif;\n    font-weight:700;\n    font-size:clamp(2.6rem, 8vw, 3.8rem);\n    line-height:1;\n    color:var(--chalk-100);\n    opacity:0;\n    letter-spacing:.01em;\n    animation: riseIn 1s ease-out forwards;\n    animation-delay:2.8s;\n  }\n\n  .underline{\n    width:0;\n    height:1px;\n    background:linear-gradient(to right, transparent, var(--mint-400), transparent);\n    margin-top:1rem;\n    animation: underlineGrow 1s ease-out forwards;\n    animation-delay:3.15s;\n  }\n\n  @keyframes underlineGrow{\n    0%{ width:0; opacity:0; }\n    30%{ opacity:1; }\n    100%{ width:120px; opacity:1; }\n  }\n\n  @keyframes riseIn{\n    0%{ opacity:0; transform:translateY(12px); }\n    100%{ opacity:1; transform:translateY(0); }\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .axis, .tick, .curve, .tracer, .peak, .wordmark, .underline, .mote{\n      animation:none !important;\n      opacity:1 !important;\n      transform:none !important;\n      stroke-dashoffset:0 !important;\n    }\n    .tracer{ display:none; }\n    .underline{ width:120px !important; }\n    .mote{ display:none; }\n  }\n</style>\n</head>\n<body>\n\n  <div class=\"dust\" id=\"dust\"></div>\n\n  <main class=\"stage\">\n    <div class=\"plot-wrap\">\n      <svg viewBox=\"0 0 320 260\" width=\"100%\" height=\"100%\" aria-hidden=\"true\">\n        <!-- coordinate axes -->\n        <line class=\"axis y\" x1=\"30\" y1=\"230\" x2=\"30\" y2=\"20\"/>\n        <line class=\"axis x\" x1=\"20\" y1=\"220\" x2=\"300\" y2=\"220\"/>\n\n        <!-- ticks -->\n        <line class=\"tick\" x1=\"26\" y1=\"60\"  x2=\"34\" y2=\"60\"  style=\"animation-delay:.55s\"/>\n        <line class=\"tick\" x1=\"26\" y1=\"100\" x2=\"34\" y2=\"100\" style=\"animation-delay:.62s\"/>\n        <line class=\"tick\" x1=\"26\" y1=\"140\" x2=\"34\" y2=\"140\" style=\"animation-delay:.69s\"/>\n        <line class=\"tick\" x1=\"26\" y1=\"180\" x2=\"34\" y2=\"180\" style=\"animation-delay:.76s\"/>\n        <line class=\"tick\" x1=\"70\"  y1=\"216\" x2=\"70\"  y2=\"224\" style=\"animation-delay:.83s\"/>\n        <line class=\"tick\" x1=\"115\" y1=\"216\" x2=\"115\" y2=\"224\" style=\"animation-delay:.90s\"/>\n        <line class=\"tick\" x1=\"205\" y1=\"216\" x2=\"205\" y2=\"224\" style=\"animation-delay:.97s\"/>\n        <line class=\"tick\" x1=\"250\" y1=\"216\" x2=\"250\" y2=\"224\" style=\"animation-delay:1.04s\"/>\n\n        <!-- parabola y = x^2, opening upward -->\n        <path class=\"curve\" d=\"M42,214 C 76,214 92,90 160,90 C 228,90 244,214 278,214\"/>\n        <circle class=\"tracer\" cx=\"0\" cy=\"0\" r=\"4\"/>\n        <circle class=\"peak\" cx=\"160\" cy=\"90\" r=\"0\"/>\n      </svg>\n    </div>\n\n    <h1 class=\"wordmark\">رياضيات</h1>\n    <div class=\"underline\"></div>\n  </main>\n\n<script>\n  // sparse chalk dust drifting slowly upward\n  const dustEl = document.getElementById('dust');\n  const total = 20;\n  for (let i = 0; i < total; i++){\n    const m = document.createElement('div');\n    m.className = 'mote';\n    const size = 1 + Math.random() * 2;\n    m.style.width = size + 'px';\n    m.style.height = size + 'px';\n    m.style.left = Math.random() * 100 + '%';\n    m.style.top = (60 + Math.random() * 40) + '%';\n    const dur = 14 + Math.random() * 10;\n    m.style.animationDuration = dur + 's, ' + dur + 's';\n    m.style.animationDelay = (Math.random() * dur * -1) + 's, ' + (Math.random() * dur * -1) + 's';\n    dustEl.appendChild(m);\n  }\n</script>\n\n</body>\n</html>"
